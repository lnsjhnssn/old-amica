---
import { Image } from "astro:assets";
import BlogPostIcons from "./BlogPostIcons.astro";

const { post } = Astro.props;
const {
  title,
  year,
  label,
  textBandcamp,
  textSpotify,
  bandcamp,
  spotify,
  image,
  type,
} = post.data;
---

<div class="text-left px-4">
  <a href={bandcamp} target="_blank">
    <Image
      src={image}
      alt=" album cover"
      quality={"high"}
      class="shadow-md border border-gray-200"
    />
  </a>
  <div class="mt-4 mb-12">
    <h3 class="text-lg md:text-xl mt-3">{title}</h3>
    <!-- <p class="font-normal">{type}</p> -->
    <p class="font-normal">{label} {year}</p>
    <div class="mt-4">
      <p class="font-normal">
        <p><a href={spotify} target="_blank">{textSpotify}</a></p>
        <a href={bandcamp} target="_blank">{textBandcamp}</a>
      </p>
    </div>
    <!-- <BlogPostIcons /> -->
  </div>
</div>
