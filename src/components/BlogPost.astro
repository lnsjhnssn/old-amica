---
import { Image } from "astro:assets";
import BlogPostIcons from "./BlogPostIcons.astro";

const { post } = Astro.props;
const {
  title,
  year,
  label,
  textBandcamp,
  textSpotify,
  bandcamp,
  spotify,
  image,
  type,
} = post.data;
---

<div class="text-left px-4 my-8 font-medium">
  <Image src={image} alt=" album cover" quality={"high"} class="shadow-md" />
  <h3 class="text-lg md:text-xl mt-3">{title}</h3>
  <p class="font-normal">{type}</p>
  <p class="font-normal">{label} {year}</p>
  <div>
    <p>
      <a href={bandcamp} target="_blank">{textBandcamp}</a>
    </p>
    <p><a href={spotify} target="_blank">{textSpotify}</a></p>
  </div>
  <!-- <BlogPostIcons /> -->
</div>
