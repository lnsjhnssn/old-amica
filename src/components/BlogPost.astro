---
import { Image } from "astro:assets";
import BlogPostIcons from "./BlogPostIcons.astro";

const { post } = Astro.props;
const {
  title,
  year,
  label,
  textBandcamp,
  textSpotify,
  bandcamp,
  spotify,
  image,
  type,
} = post.data;
---

<div class="text-left px-4">
  <a href={bandcamp} target="_blank">
    <Image src={image} alt=" album cover" quality={"high"} class="rounded" />
  </a>
  <div class="flex flex-row mt-4 mb-12 justify-between">
    <div>
      <h2 class="text-lg md:text-xl">{title}</h2>
      <p class="font-normal">{label} {year}</p>
    </div>
    <div class="flex flex-col">
      <div class="text-right">
        <a href={bandcamp} target="_blank">{textBandcamp}</a>
      </div>
      <div class="text-right">
        <a href={spotify} target="_blank">{textSpotify}</a>
      </div>
    </div>
  </div>
</div>
