---
import Image from "astro/components/Image.astro";

import on from "../content/posts/images/on.jpg";
import fyr from "../content/posts/images/fyr.jpg";
import fyrBack from "../content/posts/images/fyr-back.jpg";
import debrisSides from "../content/posts/images/debris-sides.jpg";
---

<div class="hero-grid">
  <Image src={fyr} alt="album cover of fyr" />
  <Image src={fyrBack} alt="backside of album cover fyr" />
  <div class="col-span-2 mt-4">
    <h2 class="text-xl">FYR</h2>
    <p>Whitelabrecs 2023</p>
    <br />
  </div>
  <p>
    Recorded between February and April, 2023. Our third instrumental album and
    very much the spiritual successor to Taiga, which was released on
    Whitelabrecs 2019. <br />
    <br /> Fyr is a collection of memories suspended in time. It is the overgrown
    park, the written word on the demolished building, the pulsating light of a dead
    star, the tiny fragments of color breaking through the concrete, the fear that
    love isn't enough, the silence after the machines stopped. It is to save these
    places and people from fading into oblivion. It was inspired by the words of
    Tove Jansson, the nameless voices on the shortwave radio, and the sounds of The
    Beach Boys. <br />
    <br /> Written, recorded and mixed by Old Amica. Mastered by James Edward Armstrong.
    Photography by J.M. Almqvist and Yuliana Paranko.
  </p>
</div>

<div class="hero-grid text-base">
  <Image src={debrisSides} alt="album cover of fyr" />
  <div></div>
  <div class="col-span-2 md:col-span-1">
    <h2 class="text-base">FYR</h2>
    <div>
      <p>Whitelabrecs 2023</p>
      <br />
      <p>Bandcamp</p>
      <p>Spotify</p>
      <br />
      <p>
        Recorded between February and April, 2023. Our third instrumental album
        and very much the spiritual successor to Taiga, which was released on
        Whitelabrecs 2019. <br />
        <br /> Fyr is a collection of memories suspended in time. It is the overgrown
        park, the written word on the demolished building, the pulsating light of
        a dead star, the tiny fragments of color breaking through the concrete, the
        fear that love isn't enough, the silence after the machines stopped. It is
        to save these places and people from fading into oblivion. It was inspired
        by the words of Tove Jansson, the nameless voices on the shortwave radio,
        and the sounds of The Beach Boys. <br />
        <br /> Written, recorded and mixed by Old Amica. Mastered by James Edward
        Armstrong. Photography by J.M. Almqvist and Yuliana Paranko.
      </p>
    </div>
  </div>
</div>
