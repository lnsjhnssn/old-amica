---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-black.png";
import MusicIcons from "./MusicIcons.astro";
---

<div class="max-w-7xl">
  <ul class="grid grid-cols-3 justify-items-center place-items-center">
    <li class="justify-self-start"><MusicIcons /></li>
    <li class="justify-self-center">
      <a href="/"><Image src={logo} alt="old amica" height={40} /></a>
    </li>
    <li class="justify-self-end">
      <ul>
        <li>
          <a href="mailto:oldamica@gmailcom"
            ><button
              id="contact-btn"
              type="button"
              class="text-white bg-zinc-900 font-medium rounded-lg text-xs md:text-sm px-4 py-2 text-center inline-flex items-center my-4 md:my-4"
            >
              Contact
            </button>
          </a>
        </li>
      </ul>
    </li>
  </ul>
</div>
