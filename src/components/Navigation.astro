---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-black-2.png";
import MusicIcons from "./MusicIcons.astro";
---

<div class="nav-container">
  <h1>Old Amica</h1>
  <ul>
    <li>
      <a href="https://oldamica.bandcamp.com/" target="_blank">Bandcamp</a>
    </li>
    <li>
      <a
        href="https://open.spotify.com/artist/5toq1yTDxwyzLPa6nChApJ?si=rngK7OBBQe-VDjwvNOV69w"
        target="_blank">Spotify</a
      >
    </li>
    <li>
      <a href="https://instagram.com/oldamica" target="_blank">Instagram</a>
    </li>
    <li>
      <a href="https://facebook.com/oldamica" target="_blank">Facebook</a>
    </li>
    <li>
      <a href="mailto:oldamica@gmail.com" target="_blank">Email</a>
    </li>
  </ul>

  <style>
    ul {
      list-style: none;
      padding: 0;
      margin-top: 0;
      margin-bottom: 7rem;
    }

    li {
      margin-bottom: 0.1rem;
    }

    h1 {
      font-size: 3.7rem;
    }

    @media (max-width: 1000px) {
      h1 {
        font-size: 2.5rem;
      }
    }

    .nav-container {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .nav-container ul {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    @media (hover: hover) {
      .nav-container ul li a:hover {
        color: #4c977b;
        transition: color 0.2s ease;
      }
    }
  </style>
</div>
