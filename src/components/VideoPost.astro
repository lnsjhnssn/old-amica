---
import { YouTube } from "astro-embed";

const { video } = Astro.props;
const { title, year, director, video_url, type } = video.data;
---

<div class="text-center px-4 my-8">
  <YouTube id={video_url} class="shadow-md" />

  <h2 class="text-xl mt-4">{title}</h2>
  <p>{director}</p>
  <p class="text-sm">{year}</p>

  <!-- <p>{label}</p>
  <p>Buy on <a href={bandcamp} target="_blank">Bandcamp</a></p>
  <p>Listen on <a href={spotify} target="_blank">Spotify</a></p> -->
</div>

<style>
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration: none;
  }
</style>
