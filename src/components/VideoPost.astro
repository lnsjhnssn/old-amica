---
import { YouTube } from "astro-embed";

const { video } = Astro.props;
const { title, year, director, video_url, type } = video.data;
---

<div class="video-post">
  <YouTube id={video_url} class="shadow-md" playlabel={title} />
  <div class="video-content">
    <h3>{title}</h3>
    <p>{director}</p>
    <p>{year}</p>
  </div>
</div>

<style>
  .video-post {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
