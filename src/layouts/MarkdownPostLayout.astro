---
import BaseLayout from "../layouts/BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
  <p>{frontmatter.releaseDate.toString()}</p>
  <p>Released by {frontmatter.label}</p>
  <p>Buy here <a href={frontmatter.bandcamp} target="_blank">Bandcamp</a></p>
  <p>Listen on <a href={frontmatter.spotify} target="_blank">Spotify</a></p>
  <slot />
</BaseLayout>
