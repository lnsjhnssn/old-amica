---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPostCollection from "../components/BlogPostCollection.astro";
import VideoCollection from "../components/VideoCollection.astro";
---

<BaseLayout>
  <!-- <Hero /> -->
  <section id="releases">
    <div class="text-center">
      <h2 class="text-xl md:text-3xl pt-8">RELEASES</h2>
      <BlogPostCollection />
    </div>
  </section>
  <section id="video">
    <div class="text-center bg-zinc-900 text-zinc-100">
      <h2 class="text-xl md:text-3xl pt-8">VIDEO</h2>
      <VideoCollection />
    </div>
  </section>
</BaseLayout>
